    "bf16": 1e-3
  },
  "gates": {
    "fp32_max_abs_probability_delta": 1e-5,
    "bf16_max_abs_probability_delta": 1e-3,
    "argmax_agreement": 1.0
  },
  "profile_stages": true,
  "output_dir": "artifacts/a1-equivalence-v0.2"
}
