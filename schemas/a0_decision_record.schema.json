{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ElephantRock/Athrub/schemas/a0_decision_record.schema.json",
  "title": "Athrub A0 Decision Training Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "question", "candidates"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "task_family": { "type": "string", "minLength": 1 },
    "state": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "label": { "type": "integer", "minimum": 0 },
    "target_distribution": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
    }
  },
  "oneOf": [
    {
      "required": ["label"],
      "not": { "required": ["target_distribution"] }
    },
    {
      "required": ["target_distribution"],
      "not": { "required": ["label"] }
    }
  ]
}
