{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ElephantRock/Athrub/schemas/reference_manifest.schema.json",
  "title": "Athrub A0 Reference Manifest",
  "description": "Public, identity-neutral manifest for one frozen Athrub reference artifact. External substrate identity and acquisition details remain in private research provenance and are referenced only by opaque provenance identifiers and content hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_name",
    "athrub_commit",
    "substrate",
    "tokenizer",
    "decision_head",
    "codec",
    "training",
    "benchmark"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "reference_name": {
      "type": "string",
      "pattern": "^Athrub A0 Reference v[0-9]+\\.[0-9]+$"
    },
    "athrub_commit": {
      "$ref": "#/$defs/sha256_or_git_sha"
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "immutable_revision", "private_provenance_id"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "immutable_revision": { "type": "string", "minLength": 8 },
        "private_provenance_id": { "type": "string", "minLength": 1 },
        "parameter_count": { "type": "integer", "minimum": 1 },
        "architecture_class": {
          "type": "string",
          "enum": ["causal-transformer-reference-substrate"]
        }
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "immutable_revision", "private_provenance_id"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "immutable_revision": { "type": "string", "minLength": 8 },
        "private_provenance_id": { "type": "string", "minLength": 1 }
      }
    },
    "decision_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "head_type"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "head_type": { "type": "string", "const": "scalar-linear" },
        "bias": { "type": "boolean" }
      }
    },
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_commit"],
      "properties": {
        "name": { "type": "string", "const": "TextDecisionCodec" },
        "version": { "type": "string", "const": "0.1" },
        "source_commit": { "$ref": "#/$defs/sha256_or_git_sha" }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "data_manifest_sha256", "objective", "stages"],
      "properties": {
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "data_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "objective": { "type": "string", "const": "categorical-cross-entropy" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["head-warmup", "brief-full-adaptation"]
          },
          "uniqueItems": true
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "artifact_sha256", "precision", "environment_sha256"],
      "properties": {
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "environment_sha256": { "$ref": "#/$defs/sha256" },
        "precision": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["fp32", "bf16"] },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256_or_git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    }
  }
}
